# AI Layout Coach backend (optional).
# URL of the deployed Supabase Edge Function that holds the Anthropic API key.
# Leave unset for a build with no coach — the app runs unchanged and the coach
# button reports itself unconfigured. See supabase/functions/coach/README.md.
VITE_COACH_URL=

# Classroom's retrieval-grounded coach backend (optional).
# URL of the deployed coach-rag Edge Function. Leave unset and the Classroom's
# Coach Lab runs entirely on approved corpus text — fully supported, not a
# degraded mode. See supabase/functions/coach-rag/README.md and RAG.md.
VITE_COACH_RAG_URL=
