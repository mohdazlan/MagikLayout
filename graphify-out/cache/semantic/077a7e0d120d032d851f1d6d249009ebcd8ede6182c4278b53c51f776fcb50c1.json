{"nodes": [{"id": "design_quiet_lab_bench", "label": "The Quiet Lab Bench (design north star)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A nearly-white room where the only saturated thing is the work itself. The live reflowing canvas is the one moment of boldness; header, palette, and code panel stay typographically quiet so the eye goes to cause and effect, not chrome. Structure from hairlines and a one-step brightness lift, never cards or ambient shadows."}, {"id": "design_duke_orange", "label": "Duke Orange accent", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#E8590C (deep #B54708 for text >=4.5:1): the Java-tied warm accent (Duke, Sun's palette), deliberately not Apple blue #0071E3. Reserved strictly for interactive/active states (selection, drop targets, focus, diff flash), never decoration or a background wash; a screen at rest is nearly monochrome."}], "edges": [{"source": "design_duke_orange", "target": "design_quiet_lab_bench", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "product_apple_restraint", "target": "design_quiet_lab_bench", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "product_anti_references", "target": "design_duke_orange", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_quiet_lab_bench", "target": "product_layoutlab", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "sour